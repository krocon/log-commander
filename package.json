{
  "name": "log-commander",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@12.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 1450",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"scripts/**/*.mjs\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:check-windows": "sh scripts/check-windows.sh",
    "contrast": "node scripts/check-contrast.mjs",
    "gen-log": "node scripts/gen-log.mjs",
    "demo:log": "node scripts/gen-log.mjs /tmp/app.log --rate 5000 --rotate-every 100000",
    "demo:app": "tauri dev -- -- /tmp/app.log",
    "demo:clean": "rm -f /tmp/app.log /tmp/app.log.[1-5]",
    "scripts:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/*.test.mjs\"",
    "e2e": "node scripts/e2e/run.mjs",
    "check": "npm run contrast && npm run scripts:test && npm run format:check && npm run lint && npm test && npm run build && npm run rust:fmt && npm run rust:lint && npm run rust:test"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@guiexpert/angular-table": "^22.1.109",
    "@guiexpert/table": "^1.1.109",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-cli": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-store": "^2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "playwright": "1.56.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
