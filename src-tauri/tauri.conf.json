{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Log Commander",
  "version": "../package.json",
  "identifier": "io.github.krocon.logcommander",
  "build": {
    "frontendDist": "../dist/log-commander/browser",
    "devUrl": "http://localhost:1450",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Log Commander",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 400,
        "resizable": true,
        "backgroundColor": "#14171c",
        "visible": false,
        "dragDropEnabled": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "targets": ["deb", "appimage", "dmg", "app", "msi", "nsis"],
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "homepage": "https://github.com/krocon/log-commander",
    "category": "DeveloperTool",
    "shortDescription": "Fast, colourful live log viewer",
    "longDescription": "Log Commander opens log files that other processes keep writing to and shows new lines immediately. Filter by level, search, follow – on files with millions of lines.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Live log viewer",
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true,
          "multiple": true,
          "description": "Log file(s) to open"
        }
      ]
    }
  }
}
